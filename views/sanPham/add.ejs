<!DOCTYPE html>
<html>

<head>
    <title><%= title %></title>
    <link rel='stylesheet' href='../stylesheets/style_header.css' />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://kit.fontawesome.com/ae360af17e.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="../stylesheets/sidebar.css">
</head>
<style>
    .input-equal {
        flex: 1;
    }
    .color-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }
</style>
<body>
    <div class="wrapper">
        <%- include('../inc/sidebar') %>
        <div class="main">
            <%- include('../inc/header') %>
            <div class="container my-2">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                <% } %>
                <form id="addProductForm" method="POST" action="/sanPham/add" enctype="multipart/form-data" onsubmit="return validateForm()">
                    <div class="row mt-3">
                        <div class="col col-md-2">
                            <label for="idHangSX" class="form-label">Hãng sản xuất <span class="text-danger">(*)</span></label>
                            <select class="form-select" id="idHangSX" name="idHangSX">
                                <% listHangSx.forEach((hangSx) => { %>
                                    <option value="<%= hangSx._id %>"><%= hangSx.tenHang %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col col-md-3">
                            <label for="tenDienThoai" class="form-label">Tên sản phẩm <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="tenDienThoai" name="tenDienThoai" placeholder="nhập tên điện thoại">
                        </div>
                        <div class="col col-md-4">
                            <label for="hinhAnh" class="form-label">Ảnh sản phẩm <span class="text-danger">(*)</span></label>
                            <input type="file" class="form-control" id="hinhAnh" name="hinhAnh">
                        </div>
                        <div class="col col-md-3">
                            <label for="heDieuHanh" class="form-label">Hệ điều hành <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="heDieuHanh" name="heDieuHanh" placeholder="nhập hệ điều hành">
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col col-md-2">
                            <label for="cameraTruoc" class="form-label">Camera Trước <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="cameraTruoc" name="cameraTruoc" placeholder="nhập camera trước">
                        </div>
                        <div class="col col-md-3">
                            <label for="camera" class="form-label">Camera<span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="camera" name="camera" placeholder="nhập camera sau">
                        </div>
                        
                        <div class="col col-md-4">
                            <label for="kichThuoc" class="form-label">Kích thước <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="kichThuoc" name="kichThuoc" placeholder="nhập kích thước">
                        </div>
                        <div class="col col-md-3">
                            <label for="pin" class="form-label">Pin<span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="pin" name="pin" placeholder="nhập pin">
                        </div>
                    </div>
                    <div class="row mt-2">
                        
                        <div class="col col-md-2">
                            <label for="ram" class="form-label">RAM <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="ram" name="ram" placeholder="nhập ram">
                        </div>
                        <div class="col col-md-3">
                            <label for="cPU" class="form-label">CPU <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="cPU" name="cPU" placeholder="nhập cpu">
                        </div>
                        <div class="col col-md-4">
                            <label for="sim" class="form-label">SIM <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="sim" name="sim" placeholder="nhập sim">
                        </div>
                        
                        <div class="col col-md-3">
                            <label for="namSanXuat" class="form-label">Năm sản xuất <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="namSanXuat" name="namSanXuat" placeholder="nhập năm sản xuất">
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col col-md-2">
                            <label for="giamGia" class="form-label">Giảm giá <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="giamGia" name="giamGia" placeholder="nhập giảm giá">
                        </div>
                        <div class="col col-md-3">
                            <label for="congNgheManHinh" class="form-label">Công nghệ màn hình<span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="congNgheManHinh" name="congNgheManHinh" placeholder="nhập công nghệ màn hình">
                        </div>
                        <div class="col col-md-4">
                            <label for="doPhanGiai" class="form-label">Độ phân giải <span class="text-danger">(*)</span></label>
                            <input type="text" class="form-control" id="doPhanGiai" name="doPhanGiai" placeholder="độ phân giải">
                        </div>
                        <div class="col col-md-3">
                            <label for="moTaThem" class="form-label">Mô tả thêm</label>
                            <textarea class="form-control" id="moTaThem" name="moTaThem" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col col-md-6">
                            <label for="mauSchema" class="form-label">Màu<span class="text-danger">(*)</span></label>
                            <div id="mauSchema" class="container">
                                <div class="color-row" id="colorRowTemplate">
                                    <div class="col-md-4">
                                        <input type="text" class="form-control input-equal" name="mau" placeholder="Màu sắc">
                                    </div>
                                    <div class="col-md-4">
                                        <input type="number" class="form-control input-equal" name="soLuong" placeholder="Số lượng" min="1">
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" class="form-control input-equal" name="giaTien" placeholder="Giá tiền" min="0" step="any">
                                    </div>
                                    <div>
                                        <button type="button" class="btn btn-danger remove-color-btn d-none">Xóa</button>
                                    </div>
                                </div>
                            </div>
                            
                            <button type="button" class="btn btn-secondary" onclick="addColorRow()">Thêm biến thể</button>
                        </div>
                    </div>
                    <div class="row mt-3 text-end">
                        <div class="col">
                            <button type="submit" class="btn btn-primary">Thêm sản phẩm</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function addColorRow() {
            const colorRowTemplate = document.getElementById('colorRowTemplate');
            const newColorRow = colorRowTemplate.cloneNode(true);
            newColorRow.removeAttribute('id');
            newColorRow.querySelector('.remove-color-btn').classList.remove('d-none');
            newColorRow.querySelector('.remove-color-btn').addEventListener('click', function () {
                newColorRow.remove();
            });
            document.getElementById('mauSchema').appendChild(newColorRow);
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.remove-color-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    button.closest('.color-row').remove();
                });
            });
        });

        function validateForm() {
            var tenDienThoai = document.getElementById("tenDienThoai").value.trim();
            var hinhAnh = document.getElementById("hinhAnh").files.length;
            var cameraTruoc = document.getElementById("cameraTruoc").value.trim();
            var kichThuoc = document.getElementById("kichThuoc").value.trim();
            var heDieuHanh = document.getElementById("heDieuHanh").value.trim();
            var cPU = document.getElementById("cPU").value.trim();
            var ram = document.getElementById("ram").value.trim();
            var sim = document.getElementById("sim").value.trim();
            var namSanXuat = document.getElementById("namSanXuat").value.trim();
            var giamGia = document.getElementById("giamGia").value.trim();
            var doPhanGiai = document.getElementById("doPhanGiai").value.trim();
            
            var colorRows = document.querySelectorAll('#mauSchema .color-row');
            var isColorRowValid = true;

            colorRows.forEach(function(row) {
                var mau = row.querySelector('input[name="mau"]').value.trim();
                var soLuong = row.querySelector('input[name="soLuong"]').value.trim();
                var giaTien = row.querySelector('input[name="giaTien"]').value.trim();
                if (mau === "" || soLuong === "" || giaTien === "") {
                    isColorRowValid = false;
                }
            });

            if (
                tenDienThoai === "" ||
                hinhAnh === 0 || // Check if a file is selected
                cameraTruoc === "" ||
                kichThuoc === "" ||
                heDieuHanh === "" ||
                cPU === "" ||
                ram === "" ||
                sim === "" ||
                namSanXuat === "" ||
                giamGia === "" ||
                doPhanGiai === "" ||
                !isColorRowValid // Check if color rows are valid
            ) {
                alert("Vui lòng điền đầy đủ thông tin bắt buộc");
                return false;
            }

            return true;
        }
    </script>
</body>
</html>
