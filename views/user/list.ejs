<!DOCTYPE html>
<html>

<head>
    <title><%= title %></title>
    <link rel='stylesheet' href='../stylesheets/style_header.css' />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://kit.fontawesome.com/ae360af17e.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="../stylesheets/sidebar.css">
    <style>
        .tb1 {
            width: 100%;
            font-size: 100%;
            padding: 5px;
        }

        .tb2 {
            width: 100%;
            font-size: 100%;
            padding: 5px;
        }

        th {
            border: 1px solid rgb(229, 218, 218);
            border-bottom: 2px solid;
            text-align: center;
        }

        .th2 {
            border: none;
            text-align: center;
        }

        .th2 img {
            width: 30px;
            height: 30px;
        }

        td {
            border: 1px solid rgb(229, 218, 218);
            text-align: center;
            align-items: center;
        }

        .stt {
            width: 3%;
            text-align: center;
        }

        .id {
            width: 15%;
        }

        .anh {
            width: 10%;
            height: 30px;
        }

        .ten {
            width: 20%;
        }

        .hanhDong {
            width: 10%;
        }

        .img1 {
            width: auto;
            height: auto;
            margin: auto;
            max-width: 100%;
            max-height: 50px;
            padding: 1%;
        }

        tr {
            margin-top: 10px;
        }

        .hang:hover {
            background-color: rgb(243, 241, 241);
        }

        #searchForm {
            margin: 20px auto;
        }

        .modal-body {
            display: flex;
            flex-direction: column;
            width: 100%;
        }

        .modal-body input {
            width: 100%;
            height: 50px;
            margin: 20px auto;
        }

        .preview {
            padding: 30px;
        }

        .add {
            float: right;
            width: 10%;
            margin: 10px 15px;
            text-align: center;
            font-size: 100%;
            min-width: 70px;
        }

        .top {
            display: flex;
            align-items: center;
        }

        .top #searchForm {
            width: 100%;
            margin: auto;
        }

        .top #form2 {
            width: 100%;
            margin: auto;
        }

        .action-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
        }
        .btnButton {
            color: black;
        }

        .btnButton:hover {
            color: black;
        }

        

        
    </style>
</head>

<body>
    <div class="wrapper">
        <%- include('../inc/sidebar') %>
        <div class="main">
            <%- include('../inc/header') %>
            <div class="content col-md-10 sm-10" style="overflow: auto; height: 80vh">
                <div class="top">
                    <form id="filterForm" action="/user/" method="GET" style="width: 300px; margin-right: 20px;">
                        <div class="row g-3">
                            <div class="col">
                                <select class="form-select" name="trangThai" id="trangThaiSelect">
                                    <option value="" <%= (trangThai === undefined || trangThai === '') ? 'selected' : '' %>>Tất cả</option>
                                    <option value="true" <%= trangThai === 'true' ? 'selected' : '' %>>Hoạt động</option>
                                    <option value="false" <%= trangThai === 'false' ? 'selected' : '' %>>Vô hiệu hóa</option>
                                </select>
                            </div>
                        </div>
                    </form>
                    <form id="searchForm" action="/user/search" method="GET">
                        <div class="row g-3">
                            <div class="col">
                                <input required="true" type="text" id="textQuery" name="query" class="form-control"
                                    placeholder="Nhập tài khoản...">
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">Tìm</button>
                            </div>
                        </div>
                    </form>

                </div>
                <table class="table table-bordered table-hover mt-3">
                    <thead class="align-middle text-center">
                        <tr>
                            <th scope="col" class="col-md-0.5 sm-0.5">STT</th>
                            <th scope="col" class="col-md-0">ID</th>
                            <th scope="col" class="col-md-0.5 sm-0.5">Tài khoản</th>
                            <th scope="col" class="col-md-0.5 sm-0.5">Số điện thoại</th>
                            <th scope="col" class="col-md-0.5 sm-0.5">Trạng thái</th>
                            <th scope="col" class="col-md-0">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        <% listUser.forEach((User, index) => { %>
                            <tr class="hang">
                                <td><%= (currentPage - 1) * perPage+ index + 1 %></td>
                                <td><%= User._id %></td>
                                <td><%= User.taiKhoan %></td>
                                <td><%= User.sdt %></td>
                                <td>
                                    <%if(User.trangThai){%>
                                        Hoạt động
                                    <% }else{ %>
                                        Vô hiệu hóa
                                    <% } %>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button type="button" class="btn btn-info icon-btn" style="color:#fff"
                                            data-bs-toggle="modal" data-bs-target="#exampleModal<%= index %>">
                                            Cập nhật
                                        </button>
                                        <form action="/user/update/<%= User._id %>" method="post">
                                            <div class="modal fade" id="exampleModal<%= index %>" tabindex="-1"
                                                aria-labelledby="exampleModalLabel" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-xl ">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h1 class="modal-title fs-5" id="exampleModalLabel">
                                                                <%= User.taiKhoan %>
                                                            </h1>
                                                            <button type="button" class="btn-close"
                                                                data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="row">
                                                                <div class="col">
                                                                    <label for="trangThai">Chọn trạng thái:</label>
                                                                    <select id="trangThai" name="trangThai"
                                                                        class="form-select">
                                                                        <% if (User.trangThai) { %>
                                                                            <option value="True" selected>Hoạt động</option>
                                                                            <option value="False">Vô hiệu hóa</option>
                                                                        <% } else { %>
                                                                            <option value="False" selected>Vô hiệu hóa</option>
                                                                            <option value="True">Hoạt động</option>
                                                                        <% } %>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary"
                                                                data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                        <% if (User.tenQuyen === 'User') { %>
                                            <a href="/user/getDonHangOfUser/<%= User._id %> "
                                                class="btn btn-primary icon-btn"> Xem đơn hàng</a>
                                            <% } else { %>
                                                <button class="btn btn-secondary icon-btn" disabled>Xem đơn hàng</button>
                                                    <%} %>
                                        
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
                <nav aria-label="Page navigation example">
                    <ul class="pagination">
                      <% if (hasPreviousPage) { %>
                        <li class="page-item"><a class="page-link" href="?page=<%= previousPage %>">Previous</a></li>
                      <% } %>
                      <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                        </li>
                      <% } %>
                      <% if (hasNextPage) { %>
                        <li class="page-item"><a class="page-link" href="?page=<%= nextPage %>">Next</a></li>
                      <% } %>
                    </ul>
                  </nav>
            </div>
            <%- include('../inc/footer') %>
        </div>
    </div>
    <script>
        document.getElementById('trangThaiSelect').addEventListener('change', function () {
            document.getElementById('filterForm').submit();
        });
    </script>
</body>

</html>
