<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="../stylesheets/style_header.css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <script
      src="https://kit.fontawesome.com/ae360af17e.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.10.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.10.0/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.10.0/firebase-auth-compat.js"></script>
    <link rel="stylesheet" href="../stylesheets/sidebar.css" />
    <style>
      .custom-width {
        width: 200px;
        margin-left: 10px;
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <%- include('../inc/sidebar') %>
      <div class="main">
        <%- include('../inc/header') %>

        <div class="content">
          <!-- Date selection and summary statistics -->
          <div class="col-12 bg-light p-3 shadow bg-body-tertiary rounded mb-4">
            <form
              id="searchForm"
              action="/"
              method="GET"
              class="d-flex justify-content-between align-items-center mb-4"
            >
              <input
                type="date"
                id="startDate"
                name="startDate"
                class="form-control"
                value="startDate"
              />
              <span class="mx-2">-</span>
              <input
                type="date"
                id="endDate"
                name="endDate"
                class="form-control"
                value="endDate"
              />
              <button type="submit" class="btn btn-primary custom-width">
                Thống kê
              </button>
            </form>

            <div class="row justify-content-center">
              <div class="col-md-2 col-6 mb-3">
                <div class="bg-success text-light p-3 rounded text-center">
                  <p class="mb-1">Tổng doanh thu</p>
                  <h6 class="mb-0">
                    <%= doanhThu.toLocaleString('vi-VN', { style: 'currency',
                    currency: 'VND' }) %>
                  </h6>
                </div>
              </div>
              <div class="col-md-2 col-6 mb-3">
                <div class="bg-primary text-light p-3 rounded text-center">
                  <p class="mb-1">Tổng người dùng</p>
                  <h6 class="mb-0"><%= nguoiDung %></h6>
                </div>
              </div>
              <div class="col-md-2 col-6 mb-3">
                <div class="bg-warning text-light p-3 rounded text-center">
                  <p class="mb-1">Tổng đơn hàng</p>
                  <h6 class="mb-0"><%= donHang %></h6>
                </div>
              </div>
              <div class="col-md-2 col-6 mb-3">
                <div class="bg-danger text-light p-3 rounded text-center">
                  <p class="mb-1">Đang chờ xử lý</p>
                  <h6 class="mb-0"><%= donHuy %></h6>
                </div>
              </div>
              <div class="col-md-2 col-6 mb-3">
                <div class="bg-info text-light p-3 rounded text-center">
                  <p class="mb-1">Số lượng sp bán ra</p>
                  <h6 class="mb-0"><%= soLuongSP %></h6>
                </div>
              </div>
            </div>
          </div>

          <!-- Top sản phẩm có doanh thu cao nhất -->
          <div class="row">
            <div class="col-lg-6 mb-4">
              <div class="bg-light p-4 shadow bg-body-tertiary rounded">
                <h5>Top Sản phẩm có doanh thu cao nhất</h5>
                <table class="table table-striped">
                  <thead>
                    <tr>
                      <th scope="col">STT</th>
                      <th scope="col">Tên sản phẩm</th>
                      <th scope="col">Hình ảnh</th>
                      <th scope="col">Tổng doanh thu</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% topSPDoanhThuCao.forEach((sp, index)=> { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= sp.tenSP %></td>
                      <td>
                        <img
                          src="<%= sp.hinhAnh %>"
                          alt="<%= sp.tenSP %>"
                          width="50"
                          onerror="this.src='/path/to/default-image.png';"
                        />
                      </td>

                      <td>
                        <%= sp.doanhThu.toLocaleString('vi-VN', { style:
                        'currency', currency: 'VND' }) %>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Top sản phẩm bán chạy nhất -->
            <div class="col-lg-6 mb-4">
              <div class="bg-light p-4 shadow bg-body-tertiary rounded">
                <h5>Top Sản phẩm bán chạy nhất</h5>
                <table class="table table-striped">
                  <thead>
                    <tr>
                      <th scope="col">STT</th>
                      <th scope="col">Tên sản phẩm</th>
                      <th scope="col">Hình ảnh</th>
                      <th scope="col">Số lượng bán</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% topSPBanChay.forEach((sp, index)=> { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td><%= sp.tenSP %></td>
                      <td>
                        <img
                          src="<%= sp.hinhAnh %>"
                          alt="<%= sp.tenSP %>"
                          width="50"
                        />
                      </td>
                      <td><%= sp.soLuongBan %></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Top người dùng mua hàng nhiều nhất -->
          <div class="bg-light p-4 shadow bg-body-tertiary rounded">
            <h5>Top người dùng mua hàng nhiều nhất</h5>
            <table class="table table-striped">
              <thead>
                <tr class="align-middle text-center">
                  <th scope="col">STT</th>
                  <th scope="col">Tên người</th>
                  <th scope="col">Sản phẩm mua</th>
                  <th scope="col">Số lượng</th>
                  <th scope="col">Tổng số tiền</th>
                </tr>
              </thead>
              <tbody>
                <% topNguoiDungMuaNhieuNhat.forEach((user, index)=> { %>
                <tr class="align-middle text-center">
                  <td><%= index + 1 %></td>
                  <td><%= user.tenNguoi %></td>
                  <td>
                    <ul>
                      <% user.sanPham.forEach(sp=> { %>
                      <li><%= sp.tenSP %> x <%= sp.soLuong %></li>
                      <% }) %>
                    </ul>
                  </td>
                  <td><%= user.soLuong %></td>
                  <td>
                    <%= user.tongTien.toLocaleString('vi-VN', { style:
                    'currency', currency: 'VND' }) %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <%- include('../inc/footer') %>
      </div>
    </div>
  </body>
  <script></script>
</html>
